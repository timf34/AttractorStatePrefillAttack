.env
.DS_Store
.venv/
__pycache__/
*.pyc

# Generated transcript viewer (rebuild with: python3 make_viewer.py)
transcript_viewer.html

# External cloned repos (separate git repositories)
attractor-states/
bliss-attractors/

# Deployable static site (rebuild with: python3 make_viewer.py --site site)
site/

# In-flight per-turn checkpoints written by run.py (finished runs land in results/)
results/partial/
*.log
results_capped/acts/
results_capped/podlogs/
capped/configs/*/responses.jsonl
capped/configs/*/projections.json
capped/configs/configs/
